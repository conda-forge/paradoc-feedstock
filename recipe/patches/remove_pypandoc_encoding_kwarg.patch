Description: Remove the `encoding` keyword argument from pypandoc.convert_file calls.
 pypandoc 1.17 dropped the `encoding` parameter from convert_file(), so these
 two tests raise TypeError. This patch removes the now-invalid argument.
 To be fixed upstream in a later paradoc release.
diff --git a/tests/docx_cross/test_pandoc_direct.py b/tests/docx_cross/test_pandoc_direct.py
--- a/tests/docx_cross/test_pandoc_direct.py
+++ b/tests/docx_cross/test_pandoc_direct.py
@@ -47,6 +47,5 @@
         format="markdown",
         extra_args=[f"--resource-path={main_dir.absolute()}"],
         filters=["pandoc-crossref"],
-        encoding="utf8",
         sandbox=False,
     )

diff --git a/tests/figures/test_pandoc_directly.py b/tests/figures/test_pandoc_directly.py
--- a/tests/figures/test_pandoc_directly.py
+++ b/tests/figures/test_pandoc_directly.py
@@ -30,6 +30,5 @@
         format="markdown",
         extra_args=[f"--resource-path={md_file.parent.absolute()}"],
         filters=["pandoc-crossref"],
-        encoding="utf8",
         sandbox=False,
     )

